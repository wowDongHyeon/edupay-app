# 백엔드 API 베이스 URL (예: http://10.0.1.12:8080/api). 비우면 /api 로 프록시
VITE_API_BASE=

# 오페리아 API(NL2SQL 에이전트) 베이스 URL. 비우면 목업(src/mock/operia) 사용, 실서버 생기면 URL 입력
VITE_OPERIA_API=

# 오페리아 AI 시뮬 모드(§8). true면 Claude를 가짜 오페리아로 사용(질문→SQL→result 생성).
# 우선순위: VITE_OPERIA_API > VITE_OPERIA_AI > 정적 목업. 키는 VITE_ANTHROPIC_API_KEY 재사용.
VITE_OPERIA_AI=

# AI 챗 엔드포인트(서버 경유). ※ API 키는 절대 프론트에 두지 말 것 — 서버에만.
VITE_AI_ENDPOINT=

# ───────── [시연용] 브라우저 직접 호출 (실서비스 금지) ─────────
# AI 답변 기본 사용 여부. true 일 때만 기본 ON (기본 false=로컬 하드코딩 답변). 앱 설정 토글로 덮어씀.
VITE_AI_ENABLED=true
# ⚠️ 이 키는 빌드 번들에 노출됩니다. 저한도 전용 키만, 시연 후 즉시 폐기.
VITE_ANTHROPIC_API_KEY=
VITE_CLAUDE_MODEL=claude-sonnet-4-6
VITE_CLAUDE_MAX_TOKENS=1024

# 백엔드 API 베이스 URL (예: http://10.0.1.12:8080/api). 비우면 /api 로 프록시
VITE_API_BASE=

# 오페리아 API(NL2SQL 에이전트) 베이스 URL. 비우면 목업(src/mock/operia) 사용, 실서버 생기면 URL 입력
VITE_OPERIA_API=

# 카카오 지도 JavaScript 키 (도메인 화이트리스트 보호 → 프론트 노출 OK). JS SDK 도메인에 배포/로컬 도메인 등록 필요
VITE_KAKAO_MAP_KEY=f82d0170a2da4ad990e69d935de462ab
VITE_OPERIA_API=

# 오페리아 시뮬 모드(§8 옵션 B — 프론트 alasql 실행). true면 10개 intent는 고정 SQL 템플릿을
# alasql이 dataset.json 위에서 실행(키 무관·결정적), 그 외 데이터질문만 Claude 경량 NL→SQL.
# 우선순위: VITE_OPERIA_API > VITE_OPERIA_AI > 정적 목업.
VITE_OPERIA_AI=

# AI 챗 엔드포인트(서버 경유). ※ API 키는 절대 프론트에 두지 말 것 — 서버에만.
VITE_AI_ENDPOINT=

# ───────── [시연용] 브라우저 직접 호출 (실서비스 금지) ─────────
# AI 답변 기본 사용 여부. true 일 때만 기본 ON (기본 false=로컬 하드코딩 답변). 앱 설정 토글로 덮어씀.
VITE_AI_ENABLED=true
# ⚠️ 이 키는 빌드 번들에 노출됩니다. 저한도 전용 키만, 시연 후 즉시 폐기.
VITE_ANTHROPIC_API_KEY=
VITE_CLAUDE_MODEL=claude-sonnet-4-6
VITE_CLAUDE_MAX_TOKENS=1024

# ───────── 배포(공개 URL) 보안 프로파일 — MOCK_API_설계.md §10 ─────────
# 공개 배포본 번들에 Claude 키가 들어가면 누구나 추출 가능 → 키를 빌드 환경으로 끈다.
# `vite build`는 .env.production 을 로드한다(이 레포의 .env.production 참고):
#   VITE_ANTHROPIC_API_KEY=(빈값)  VITE_AI_ENABLED=false  VITE_OPERIA_AI=true  VITE_OPERIA_API=(빈값)
# 키 없이도 10개 데이터 질문(alasql 템플릿)은 정상, 새 자유 질문은 "아직 지원하지 않는 질문" 안내.
# 검증: dist 빌드 후 `grep -r "sk-ant" dist/` → 0건.

# ───────── 데이터 창구(Data Source) 선택 — DATASOURCE_설계.md §3 ─────────
# 활성 창구: operia | backend | mock. 미설정/오타 → mock 폴백(화면 안 깨짐).
# 채널 분기는 getDataSource() 한 곳뿐 — 렌더/상태/화면은 채널 불변.
VITE_DATA_SOURCE=mock

# 임시 백엔드 채널(§5.2). operia 와 동일 계약(SSE data→result). 비우면 backend 선택해도 mock 폴백.
VITE_BACKEND_API=
VITE_BACKEND_TOKEN=
# 백엔드 채널 companyId(§갭③). 백엔드 기대값 EDUPAY(테넌트 식별자 — 현재 격리엔 미사용).
VITE_BACKEND_COMPANY_ID=EDUPAY

# 오페리아 채널 접속(§5.1, 값은 추후 주입 §13). 비우면 operia 선택해도 mock 폴백.
# VITE_OPERIA_API 는 위 오페리아 시뮬 섹션에 이미 있음.
VITE_OPERIA_TOKEN=
VITE_OPERIA_COMPANY_ID=OPERIA

# ───────── [개발용 디버그 표시] 각각 독립 on/off. 기본 false(데모/배포 깔끔), 개발 시 개별 true ─────────
VITE_SHOW_SQL=false            # SQL/조회조건 칩 노출
VITE_SHOW_SOURCE_BADGE=false   # "operia · balance" 데이터소스 배지 토스트

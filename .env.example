# 백엔드 API 베이스 URL (예: http://10.0.1.12:8080/api). 비우면 /api 로 프록시
VITE_API_BASE=

# AI 챗 엔드포인트(서버 경유). ※ API 키는 절대 프론트에 두지 말 것 — 서버에만.
VITE_AI_ENDPOINT=

# ───────── [시연용] 브라우저 직접 호출 (실서비스 금지) ─────────
# ⚠️ 이 키는 빌드 번들에 노출됩니다. 저한도 전용 키만, 시연 후 즉시 폐기.
VITE_ANTHROPIC_API_KEY=
VITE_CLAUDE_MODEL=claude-sonnet-4-6
VITE_CLAUDE_MAX_TOKENS=1024

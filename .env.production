# ───────── 배포(공개 URL) 프로파일 — MOCK_API_설계.md §10 ─────────
# `vite build`(production mode)가 이 파일을 로드해 번들에 인라인한다.
# ⚠️ Claude API 키를 절대 넣지 않는다(번들=공개 → 키 추출 가능). 빌드 환경으로 Claude를 끈다.
#
# 동작: 10개 데이터 질문 = alasql 고정 템플릿(키 무관, 정상). 새 자유 데이터 질문 = 친절 안내(Claude 호출 안 함).
#       자유 대화 = 로컬 fallback(AI 토글 UI 미노출). → 번들·네트워크 어디에도 Claude 키/호출 없음.

# Claude 키 — 배포본은 반드시 빈값(번들 미포함)
VITE_ANTHROPIC_API_KEY=
# 자유대화 Claude 기능 OFF(토글도 숨김 → 로컬 답변만)
VITE_AI_ENABLED=false
# 오페리아 시뮬(alasql 템플릿) ON — 키와 무관하게 10개 차트 동작
VITE_OPERIA_AI=true
# 실 오페리아 서버(나중에 URL). 비우면 시뮬(alasql)
VITE_OPERIA_API=
# 백엔드 베이스(미사용)
VITE_API_BASE=
